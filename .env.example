APP_ENV=dev
SECRET_KEY=change-me
DATABASE_URL=postgresql+psycopg://kyja:kyja@localhost:5432/kyja
REDIS_URL=redis://localhost:6379/0
# Tâches de fond (Celery + Redis) : mettre true quand Redis tourne et que le worker est lancé. Sinon le site fait tout seul.
USE_CELERY=false

# Cloudflare R2
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=kyja-beaute
R2_PUBLIC_BASE_URL=

# Resend
RESEND_API_KEY=
EMAIL_FROM=KYJA BEAUTÉ <no-reply@example.com>

# Dossier temporaire des uploads avant traitement
UPLOAD_TMP_DIR=./tmp_uploads

MEDIA_DIR=./media_files
IMAGE_MAX_MB=10
# FFMPEG_BIN=C:/chemin/vers/ffmpeg.exe

SALON_TIMEZONE=America/Toronto
PRIVATE_DIR=./private_files
R2_PRIVATE_BUCKET=kyja-private

# Notifications : tant que ces valeurs sont vides, courriels et SMS sont en « aperçu » (Admin > Messages envoyés)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
PUBLIC_BASE_URL=http://localhost:8000
